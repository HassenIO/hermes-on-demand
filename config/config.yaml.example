# Deployed to ~/.hermes/config.yaml on the VPS by remote bootstrap.
# Secrets stay in ~/.hermes/.env — do not put API keys here.
#
# Official reference:
#   https://hermes-agent.nousresearch.com/docs/user-guide/configuration
#   https://hermes-agent.nousresearch.com/docs/integrations/providers

model:
  provider: openrouter
  # Chat, cron, and long-form content all use this model. Do not pin Sonnet.
  default: xiaomi/mimo-v2.5

terminal:
  backend: docker
  # Custom image with Agent-Reach zero-config CLIs (./scripts/deploy.sh --agent-reach).
  # Falls back to nikolaik base if Agent-Reach not installed yet.
  docker_image: "hermes-terminal:agent-reach"
  timeout: 180
  lifetime_seconds: 300
  container_cpu: 1
  # Keep low on small VPS (~1.5–2 GB host RAM). Raise on larger hosts.
  container_memory: 768
  container_disk: 10240
  container_persistent: true
  docker_network: true
  docker_persist_across_processes: true
  docker_shm_size: 64m
  docker_forward_env:
    - GITHUB_TOKEN
    - NOTION_API_KEY
    - NOTION_TOKEN
    - NOTION_REPORTS_PARENT_PAGE_ID
  # Put ~/.hermes/bin first so bare `notion-cli` works in the sandbox
  docker_env:
    PATH: "/root/.hermes/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"
  docker_volumes:
    - "/root/.hermes/cache/documents:/output"
    - "/root/.hermes/memories:/root/.hermes/memories:ro"
    - "/root/.hermes/CV.md:/root/.hermes/CV.md:ro"
    - "/root/.hermes/bin:/root/.hermes/bin:ro"
    - "/root/.hermes/bin/notion-cli:/usr/local/bin/notion-cli:ro"
    - "/root/.hermes/notion:/root/.hermes/notion:ro"
    # Long-form content artifacts (newsletters, reports, ebooks) — writable
    - "/root/.hermes/content:/root/.hermes/content"
    - "/root/.agent-reach:/root/.agent-reach"

display:
  tool_progress: off
  busy_input_mode: interrupt
  platforms:
    discord:
      reasoning_style: subtext

# Isolate sessions per user in shared channels (Telegram groups + Discord)
group_sessions_per_user: true

# Discord (optional). Secrets stay in .env — DISCORD_BOT_TOKEN, DISCORD_ALLOWED_USERS, etc.
# Docs: docs/07-discord-gateway.md
discord:
  require_mention: true
  thread_require_mention: false
  auto_thread: true
  reactions: true
  history_backfill: true
  history_backfill_limit: 50
  allow_mentions:
    everyone: false
    roles: false
    users: true
    replied_user: true

# Web tools: SearXNG (self-hosted search) + Firecrawl lite (extract)
# Deploy: ./scripts/deploy.sh --firecrawl
# Env: SEARXNG_URL=http://127.0.0.1:8888  FIRECRAWL_API_URL=http://127.0.0.1:3002
web:
  backend: firecrawl
  search_backend: searxng
  extract_backend: firecrawl

# Mnemosyne = default memory provider (side-venv: ~/.hermes/.mnemosyne/venv).
# Install: ./scripts/deploy.sh --mnemosyne
# Docs: https://github.com/mnemosyne-oss/mnemosyne/blob/main/docs/hermes-integration.md
#
# Built-in MEMORY.md/USER.md injection is off to avoid duplicate context.
# Seeds still live in artifacts/ and on disk for rollback.
memory:
  provider: mnemosyne
  memory_enabled: false
  user_profile_enabled: false
  memory_char_limit: 2200
  user_char_limit: 1375
  write_approval: false

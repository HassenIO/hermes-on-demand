# Deployed to ~/.hermes/config.yaml on the VPS by remote bootstrap.
# Secrets stay in ~/.hermes/.env — do not put API keys here.
#
# Official reference:
#   https://hermes-agent.nousresearch.com/docs/user-guide/configuration
#   https://hermes-agent.nousresearch.com/docs/integrations/providers

model:
  provider: openrouter
  default: xiaomi/mimo-v2.5

terminal:
  backend: docker
  # Custom image with Agent-Reach zero-config CLIs (./scripts/deploy.sh --agent-reach).
  # Falls back to nikolaik base if Agent-Reach not installed yet.
  docker_image: "hermes-terminal:agent-reach"
  timeout: 180
  lifetime_seconds: 300
  container_cpu: 1
  # Keep low on small VPS (~1.5–2 GB host RAM). Raise on larger hosts.
  container_memory: 768
  container_disk: 10240
  container_persistent: true
  docker_network: true
  docker_persist_across_processes: true
  docker_shm_size: 64m
  docker_forward_env:
    - GITHUB_TOKEN
  docker_volumes:
    - "/root/.hermes/cache/documents:/output"
    - "/root/.hermes/memories:/root/.hermes/memories:ro"
    - "/root/.agent-reach:/root/.agent-reach"

display:
  tool_progress: off
  busy_input_mode: interrupt

# Self-hosted Firecrawl on the VPS (see firecrawl/ + ./scripts/deploy.sh --firecrawl)
web:
  backend: firecrawl

# Mnemosyne = default memory provider (side-venv: ~/.hermes/.mnemosyne/venv).
# Install: ./scripts/deploy.sh --mnemosyne
# Docs: https://github.com/mnemosyne-oss/mnemosyne/blob/main/docs/hermes-integration.md
#
# Built-in MEMORY.md/USER.md injection is off to avoid duplicate context.
# Seeds still live in artifacts/ and on disk for rollback.
memory:
  provider: mnemosyne
  memory_enabled: false
  user_profile_enabled: false
  memory_char_limit: 2200
  user_char_limit: 1375
  write_approval: false

# Deployed to ~/.hermes/config.yaml on the VPS by remote bootstrap.
# Secrets stay in ~/.hermes/.env — do not put API keys here.
#
# Official reference:
#   https://hermes-agent.nousresearch.com/docs/user-guide/configuration
#   https://hermes-agent.nousresearch.com/docs/integrations/providers

model:
  provider: openrouter
  default: xiaomi/mimo-v2.5

terminal:
  backend: docker
  docker_image: "nikolaik/python-nodejs:python3.11-nodejs20"
  timeout: 180
  lifetime_seconds: 300
  container_cpu: 1
  # Keep low on small VPS (~1.5–2 GB host RAM). Raise on larger hosts.
  container_memory: 512
  container_disk: 10240
  container_persistent: true
  docker_network: true
  docker_persist_across_processes: true
  docker_shm_size: 64m
  docker_volumes:
    - "/root/.hermes/cache/documents:/output"
    # So agent file tools can read seeded profile if they look on disk
    - "/root/.hermes/memories:/root/.hermes/memories:ro"

display:
  tool_progress: off
  busy_input_mode: interrupt

# Self-hosted Firecrawl on the VPS (see firecrawl/ + ./scripts/deploy.sh --firecrawl)
web:
  backend: firecrawl

# Built-in memory: ~/.hermes/memories/{USER,MEMORY}.md (seeded from artifacts/)
# Injected into system prompt at session start — agent should NOT need to read_file them.
# Format: entries separated by a line containing only §
# Docs: https://hermes-agent.nousresearch.com/docs/user-guide/features/memory
memory:
  memory_enabled: true
  user_profile_enabled: true
  memory_char_limit: 2200
  user_char_limit: 1375
  write_approval: false

# Copy to .env and fill in real values:
#   cp .env.sample .env
#
# .env is gitignored. Never commit secrets.
# Deploy scripts read .env on your Mac and push only Hermes runtime
# secrets to the VPS (TARGET_*/SSH_* stay local).

# =============================================================================
# Deploy (Mac → VPS) — used only by scripts/deploy.sh on your machine
# =============================================================================
TARGET_HOST=
TARGET_USER=
# SSH_PORT=22
# SSH_IDENTITY_FILE=
# REMOTE_DIR=~/hermes-setup

# =============================================================================
# LLM — OpenRouter (model id is pinned in config/config.yaml.example)
# Model: xiaomi/mimo-v2.5  |  https://openrouter.ai/xiaomi/mimo-v2.5
# Key:   https://openrouter.ai/keys
# =============================================================================
OPENROUTER_API_KEY=

# =============================================================================
# Telegram gateway
# Bot token: @BotFather → /newbot
# User ID:   @userinfobot (numeric, not @username)
# Docs:      https://hermes-agent.nousresearch.com/docs/user-guide/messaging/telegram
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# TELEGRAM_HOME_CHANNEL=
# TELEGRAM_HOME_CHANNEL_NAME=
# TELEGRAM_GROUP_ALLOWED_USERS=
# TELEGRAM_GROUP_ALLOWED_CHATS=

# Deny-by-default is correct for a bot with terminal access.
# GATEWAY_ALLOW_ALL_USERS=false

# Prefer plain api.telegram.org (recommended on VPS; deploy defaults this to true)
# HERMES_TELEGRAM_DISABLE_FALLBACK_IPS=true

# =============================================================================
# Optional tool / voice keys (only if you enable those tools later)
# =============================================================================
# FIRECRAWL_API_KEY=
# PARALLEL_API_KEY=
# EXA_API_KEY=
# VOICE_TOOLS_OPENAI_KEY=
# GROQ_API_KEY=
# ELEVENLABS_API_KEY=
# GITHUB_TOKEN=
